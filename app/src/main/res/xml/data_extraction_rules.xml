<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: cloud backup and device-to-device transfer (also used by Seedvault).
     Only learning progress and settings are backed up. verbs.db ships with the app
     and is restored from the APK, so it is left out. -->
<data-extraction-rules>
  <cloud-backup>
    <include domain="database" path="progress.db" />
    <include domain="file" path="datastore/settings.preferences_pb" />
  </cloud-backup>
  <device-transfer>
    <include domain="database" path="progress.db" />
    <include domain="file" path="datastore/settings.preferences_pb" />
  </device-transfer>
</data-extraction-rules>
